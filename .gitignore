# =============================================================================
# Loopr — Financial Analytics Dashboard
# Project .gitignore
# =============================================================================

# -------------------------
# Environment & Secrets
# -------------------------
.env
.env.*
!.env.example
backend/.env
frontend/.env

# -------------------------
# Dependencies
# -------------------------
node_modules/
backend/node_modules/
frontend/node_modules/

# -------------------------
# Build Outputs
# -------------------------
dist/
build/
backend/dist/
frontend/dist/

# -------------------------
# TypeScript
# -------------------------
*.tsbuildinfo
backend/*.tsbuildinfo
frontend/*.tsbuildinfo

# -------------------------
# Logs
# -------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -------------------------
# OS
# -------------------------
.DS_Store
Thumbs.db
Desktop.ini

# -------------------------
# IDE
# -------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# -------------------------
# Testing & Coverage
# -------------------------
coverage/
.nyc_output/

# -------------------------
# Misc Cache
# -------------------------
.cache/
.parcel-cache/
.turbo/
.eslintcache
